---
import { formatText } from '../utils/textFormatter';

interface Props {
 heading: string;
 subheading: string;
 text?: string;
 cta?: string;
 ctaLink?: string;
 secondaryCta?: string;
 secondaryCtaLink?: string;
 backgroundImage?: string;
}

const { 
 heading, 
 subheading, 
 text,
 cta, 
 ctaLink, 
 secondaryCta, 
 secondaryCtaLink,
 backgroundImage
} = Astro.props;
---

<section data-component="Hero" class="section-standard min-h-[70vh] flex items-center relative overflow-hidden bg-brand-bg">
 {backgroundImage && (
 <div class="absolute inset-0 z-0">
 <img 
 src={backgroundImage} 
 alt="" 
 class="w-full h-full object-cover" 
 />
 <div class="absolute inset-0 bg-black/40"></div>
 <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-brand-bg"></div>
 </div>
 )}
 <div class="container mx-auto px-6 relative z-10">
 <div class="max-w-5xl reveal">
 <p class="font-brand-heading text-white text-xl mb-4 tracking-wider uppercase" set:html={formatText(subheading)}></p>
 <h1 class="font-brand-heading text-5xl md:text-8xl text-white mb-10 max-w-4xl leading-tight" set:html={formatText(heading)}></h1>
 {text && (
 <p class="font-brand-body text-xl text-white mb-14 max-w-2xl leading-relaxed" set:html={formatText(text)}></p>
 )}
 {(cta || secondaryCta) && (
 <div class="flex flex-col sm:flex-row justify-start gap-6">
 {cta && (
 <a 
 href={ctaLink || "#"} 
 class="px-10 py-5 bg-brand-secondary text-white font-brand-heading font-bold rounded-xl shadow-2xl transition-all transform hover:-translate-y-1 hover:scale-105"
 >
 {cta}
 </a>
 )}
 {secondaryCta && (
 <a 
 href={secondaryCtaLink || "#"} 
 class="px-10 py-5 border-2 border-white/20 text-white font-brand-heading font-bold rounded-xl transition-all transform hover:-translate-y-1 hover:bg-brand-bg"
 >
 {secondaryCta}
 </a>
 )}
 </div>
 )}
 </div>
 </div>
</section>
