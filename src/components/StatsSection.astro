---
import { formatText } from '../utils/textFormatter';

interface Stat {
 value: string;
 label: string;
}

interface Props {
 stats: Stat[];
 columns?: 2 | 3 | 4;
}

const { stats, columns } = Astro.props;

// Determine grid columns based on prop or array length
const colsCount = columns || (stats.length === 3 ? 3 : 4);

const gridClasses = {
 2: 'grid-cols-2',
 3: 'grid-cols-1 sm:grid-cols-3',
 4: 'grid-cols-2 md:grid-cols-4'
};
---

<section data-component="StatsSection" class="section-accent bg-brand-primary py-20">
 <div class="container mx-auto px-6 reveal">
 <div class={`grid ${gridClasses[colsCount as keyof typeof gridClasses]} gap-12 md:gap-16`}>
 {stats.map((stat) => (
 <div class="text-center flex flex-col items-center group">
 <div class="font-brand-heading text-5xl md:text-7xl mb-4 text-white font-bold tracking-tighter group-hover:scale-110 transition-transform duration-500" set:html={formatText(stat.value)}>
 </div>
 <div class="font-brand-heading text-[10px] md:text-xs font-bold uppercase tracking-[0.3em] text-white group-hover:text-white transition-colors" set:html={formatText(stat.label)}>
 </div>
 <div class="w-8 h-1 bg-brand-secondary mt-6 rounded-full group-hover: group-hover:w-12 transition-all duration-500"></div>
 </div>
 ))}
 </div>
 </div>
</section>
