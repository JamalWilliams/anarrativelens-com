---
import { getSiteConfig } from '../lib/config';
import { formatText } from '../utils/textFormatter';

const config = await getSiteConfig();
---

<nav data-component="Nav" class="sticky top-0 z-50 border-b-2 border-white/20 py-3 px-4 bg-brand-bg">
 <div class="max-w-7xl mx-auto flex justify-between items-center px-4 reveal">
 <a href="/" class="flex items-center gap-3 shrink-0">
 {config.brand.logo ? (
 <img src={config.brand.logo} alt={config.brand.name} class="h-8 w-auto mix-blend-luminosity hover:mix-blend-normal transition-all" />
 ) : (
 <span class="font-brand-heading text-xl font-bold tracking-tight text-white">{config.brand.name}</span>
 )}
 </a>
 
 <div class="flex items-center gap-12">
 <!-- Desktop Menu -->
 <ul class="hidden lg:flex items-center gap-10 font-brand-heading font-bold uppercase tracking-[0.2em]">
 {config.navigation.map((item: any) => (
 <li class="relative group py-2">
 {item.children ? (
 <>
 <button class="flex items-center gap-2 hover:text-brand-secondary transition-colors text-white group uppercase tracking-widest text-base font-bold">
 {item.label}
 <svg class="w-4 h-4 transition-transform group-hover:rotate-180 " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
 <path d="M6 9l6 6 6-6" />
 </svg>
 </button>
 <div class="absolute top-full left-0 w-64 pt-4 invisible group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
 <div class="bg-brand-bg border-2 border-white/20 rounded-xl shadow-2xl overflow-hidden p-3 ">
 <a href={item.path} class="block px-4 py-3 text-white hover:text-brand-secondary transition-colors font-brand-heading font-bold border-b-2 border-white/10 mb-2 text-xs uppercase tracking-widest">
 Overview
 </a>
 {item.children.map((child: any) => (
 <a href={child.path} class="block px-4 py-3 text-white hover:text-brand-secondary transition-colors font-brand-heading text-sm font-bold uppercase tracking-wider">
 {child.label}
 </a>
 ))}
 </div>
 </div>
 </>
 ) : (
 <a href={item.path} class="hover:text-brand-secondary transition-colors text-white text-base font-bold">{item.label}</a>
 )}
 </li>
 ))}
 </ul>
 
 <!-- Desktop CTA -->
 <a href="/contact" class="hidden sm:inline-block px-8 py-3 rounded-xl text-sm font-brand-heading font-bold uppercase tracking-widest text-white shadow-lg hover:shadow-brand-secondary/20 transition-all bg-brand-secondary hover:scale-105 active:scale-95 shrink-0">
 Start Your Story
 </a>

 <!-- Mobile Toggle -->
 <button id="mobile-toggle" class="lg:hidden text-white p-2" aria-label="Toggle Menu">
 <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
 <line x1="3" y1="12" x2="21" y2="12" class="line-mid transition-all duration-300"></line>
 <line x1="3" y1="6" x2="21" y2="6" class="line-top transition-all duration-300"></line>
 <line x1="3" y1="18" x2="21" y2="18" class="line-bot transition-all duration-300"></line>
 </svg>
 </button>
 </div>
 </div>

 <!-- Mobile Menu Overlay -->
 <div id="mobile-menu" class="hidden fixed inset-0 bg-brand-bg z-40 h-screen w-screen overflow-y-auto pt-32 pb-12 px-8 transition-all duration-300 transform translate-y-8 opacity-0">
 <nav class="flex flex-col items-center gap-8 w-full max-w-sm mx-auto">
 {config.navigation.map((item: any) => (
 <div class="w-full flex flex-col items-center text-center">
 {item.children ? (
 <div class="w-full flex flex-col items-center gap-5">
 <span class="font-brand-heading text-[10px] font-bold uppercase tracking-[0.3em] text-brand-secondary mb-2 ">{item.label}</span>
 <a href={item.path} class="font-brand-heading text-3xl font-bold text-white hover:text-brand-secondary transition-colors mobile-link tracking-tight">Overview</a>
 {item.children.map((child: any) => (
 <a href={child.path} class="font-brand-heading text-3xl font-bold text-white hover:text-brand-secondary transition-colors mobile-link tracking-tight">{child.label}</a>
 ))}
 <div class="w-12 h-0.5 bg-white/10 my-4 rounded-full"></div>
 </div>
 ) : (
 <a href={item.path} class="font-brand-heading text-3xl font-bold text-white hover:text-brand-secondary transition-colors mobile-link tracking-tight">{item.label}</a>
 )}
 </div>
 ))}
 </nav>
 <a href="/contact" class="w-full text-center px-8 py-5 rounded-xl font-brand-heading font-bold text-lg uppercase tracking-widest text-white bg-brand-secondary shadow-2xl mobile-link mt-8 hover:scale-105 active:scale-95 transition-all">
 Start Your Story
 </a>
 </div>
</nav>

<script>
  function initNav() {
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');
    const lines = toggle?.querySelectorAll('line');
    const links = document.querySelectorAll('.mobile-link');

    if (!toggle || !menu) return;

    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen) {
        // Open
        menu?.classList.remove('hidden');
        // Force reflow
        menu?.offsetHeight;
        menu?.classList.remove('translate-y-8', 'opacity-0');
        menu?.classList.add('translate-y-0', 'opacity-100');
        document.body.style.overflow = 'hidden';

        if (lines && lines.length >= 3) {
          lines[0].style.opacity = '0';
          lines[1].setAttribute('x1', '18'); lines[1].setAttribute('y1', '6'); lines[1].setAttribute('x2', '6'); lines[1].setAttribute('y2', '18');
          lines[2].setAttribute('x1', '6'); lines[2].setAttribute('y1', '6'); lines[2].setAttribute('x2', '18'); lines[2].setAttribute('y2', '18');
        }
      } else {
        // Close
        menu?.classList.remove('translate-y-0', 'opacity-100');
        menu?.classList.add('translate-y-8', 'opacity-0');
        document.body.style.overflow = '';
        
        if (lines && lines.length >= 3) {
          lines[0].style.opacity = '1';
          lines[1].setAttribute('x1', '3'); lines[1].setAttribute('y1', '6'); lines[1].setAttribute('x2', '21'); lines[1].setAttribute('y2', '6');
          lines[2].setAttribute('x1', '3'); lines[2].setAttribute('y1', '18'); lines[2].setAttribute('x2', '21'); lines[2].setAttribute('y2', '18');
        }

        setTimeout(() => {
          if (!isMenuOpen) {
            menu?.classList.add('hidden');
          }
        }, 300);
      }
    }

    toggle.addEventListener('click', toggleMenu);

    links.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) {
          toggleMenu();
        }
      });
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen) {
        toggleMenu();
      }
    });

    // Handle resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isMenuOpen) {
        toggleMenu();
      }
    });
  }

  // Initial load
  initNav();

  // Re-run on page load for View Transitions compatibility
  document.addEventListener('astro:page-load', initNav);
</script>
