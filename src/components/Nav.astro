---
import { getSiteConfig } from '../lib/config';
import { formatText } from '../lib/textFormatter';

const config = await getSiteConfig();
---

<nav data-component="Nav" class="sticky top-0 z-50 backdrop-blur-md border-b border-white/20 p-4 bg-brand-bg">
  <div class="max-w-7xl mx-auto flex justify-between items-center px-4">
    <a href="/" class="flex items-center gap-3">
      {config.brand.logo ? (
        <img src={config.brand.logo} alt={config.brand.name} class="h-10 w-auto mix-blend-luminosity hover:mix-blend-normal transition-all" />
      ) : (
        <span class="font-brand-heading text-2xl font-bold tracking-tight text-white">{config.brand.name}</span>
      )}
    </a>
    <div class="flex items-center space-x-4 sm:space-x-10">
      <!-- Desktop Menu -->
      <ul class="hidden md:flex space-x-8 text-sm font-brand-heading font-bold uppercase tracking-widest items-center">
        {config.navigation.map((item: any) => (
          <li class="relative group py-2">
            {item.children ? (
              <>
                <button class="flex items-center gap-2 hover:text-brand-secondary transition-colors text-white/70 group uppercase tracking-widest text-[11px]">
                  {item.label}
                  <svg class="w-3 h-3 transition-transform group-hover:rotate-180 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
                <div class="absolute top-full left-1/2 -translate-x-1/2 w-64 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
                  <div class="bg-brand-bg border-2 border-white/20 rounded-xl shadow-2xl overflow-hidden p-3 backdrop-blur-xl">
                    <a href={item.path} class="block px-4 py-3 text-white hover:bg-white/10 rounded-lg transition-colors font-brand-heading font-bold border-b border-white/10 mb-2 text-xs uppercase tracking-widest">
                      Overview
                    </a>
                    {item.children.map((child: any) => (
                      <a href={child.path} class="block px-4 py-3 text-white/70 hover:text-white hover:bg-white/10 rounded-lg transition-colors font-brand-body text-sm">
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <a href={item.path} class="hover:text-brand-secondary transition-colors text-white/70 text-[11px]">{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      
      <!-- Desktop CTA -->
      <a href="/contact" class="hidden sm:inline-block px-6 py-2.5 rounded-xl text-xs font-brand-heading font-bold uppercase tracking-widest text-white shadow-lg hover:shadow-brand-secondary/20 transition-all bg-brand-secondary hover:scale-105 active:scale-95">
        Book Now
      </a>

      <!-- Mobile Toggle -->
      <button id="mobile-toggle" class="md:hidden text-white p-2" aria-label="Toggle Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12" class="line-mid transition-all duration-300"></line>
          <line x1="3" y1="6" x2="21" y2="6" class="line-top transition-all duration-300"></line>
          <line x1="3" y1="18" x2="21" y2="18" class="line-bot transition-all duration-300"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="hidden md:hidden fixed inset-0 bg-brand-bg/95 backdrop-blur-xl z-40 h-screen w-screen overflow-y-auto pt-32 pb-12 px-8 transition-all duration-500 opacity-0 translate-y-8">
    <nav class="flex flex-col items-center gap-8 w-full max-w-sm mx-auto">
      {config.navigation.map((item: any) => (
        <div class="w-full flex flex-col items-center text-center">
          {item.children ? (
            <div class="w-full flex flex-col items-center gap-5">
              <span class="font-brand-heading text-[10px] font-bold uppercase tracking-[0.3em] text-brand-secondary mb-2 opacity-80">{item.label}</span>
              <a href={item.path} class="font-brand-heading text-3xl font-bold text-white hover:text-brand-secondary transition-colors mobile-link tracking-tight">Overview</a>
              {item.children.map((child: any) => (
                <a href={child.path} class="font-brand-heading text-3xl font-bold text-white/70 hover:text-brand-secondary transition-colors mobile-link tracking-tight">{child.label}</a>
              ))}
              <div class="w-12 h-0.5 bg-white/10 my-4 rounded-full"></div>
            </div>
          ) : (
            <a href={item.path} class="font-brand-heading text-3xl font-bold text-white hover:text-brand-secondary transition-colors mobile-link tracking-tight">{item.label}</a>
          )}
        </div>
      ))}
      <a href="/contact" class="w-full text-center px-8 py-5 rounded-xl font-brand-heading font-bold text-lg uppercase tracking-widest text-white bg-brand-secondary shadow-2xl mobile-link mt-8 hover:scale-105 active:scale-95 transition-all">
        Book Now
      </a>
    </nav>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const lines = toggle?.querySelectorAll('line');
  const links = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    const isClosed = menu?.classList.contains('hidden');
    
    if (isClosed) {
      // Open
      menu?.classList.remove('hidden');
      setTimeout(() => {
        menu?.classList.remove('opacity-0', 'translate-y-8');
        menu?.classList.add('opacity-100', 'translate-y-0');
      }, 10);
      document.body.style.overflow = 'hidden';

      if (lines) {
        lines[0].style.opacity = '0';
        lines[1].setAttribute('x1', '18'); lines[1].setAttribute('y1', '6'); lines[1].setAttribute('x2', '6'); lines[1].setAttribute('y2', '18');
        lines[2].setAttribute('x1', '6'); lines[2].setAttribute('y1', '6'); lines[2].setAttribute('x2', '18'); lines[2].setAttribute('y2', '18');
      }
    } else {
      // Close
      menu?.classList.add('opacity-0', 'translate-y-8');
      menu?.classList.remove('opacity-100', 'translate-y-0');
      document.body.style.overflow = '';
      
      if (lines) {
        lines[0].style.opacity = '1';
        lines[1].setAttribute('x1', '3'); lines[1].setAttribute('y1', '6'); lines[1].setAttribute('x2', '21'); lines[1].setAttribute('y2', '6');
        lines[2].setAttribute('x1', '3'); lines[2].setAttribute('y1', '18'); lines[2].setAttribute('x2', '21'); lines[2].setAttribute('y2', '18');
      }

      setTimeout(() => {
        menu?.classList.add('hidden');
      }, 500);
    }
  }

  toggle?.addEventListener('click', toggleMenu);

  links.forEach(link => {
    link.addEventListener('click', () => {
      if (!menu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && !menu?.classList.contains('hidden')) {
      toggleMenu();
    }
  });
</script>
