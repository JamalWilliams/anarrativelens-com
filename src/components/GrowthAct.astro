---
import { formatText } from '../utils/textFormatter';

interface Props {
 act: string;
 title: string;
 subtitle?: string;
 description: string;
 features: string[];
 price?: string;
 setup?: string;
 variant?: 'light-brown' | 'green';
 ctaLink?: string;
 ctaText?: string;
}

const { 
 act, 
 title, 
 subtitle,
 description, 
 features, 
 price, 
 setup, 
 variant = 'light-brown',
 ctaLink,
 ctaText = "Explore More"
} = Astro.props;

const bgClass = variant === 'green' ? 'bg-brand-secondary' : 'bg-brand-primary';
const textColorClass = variant === 'green' ? 'text-brand-bg' : 'text-brand-text';
const headingColorClass = variant === 'green' ? 'text-brand-bg' : 'text-white';
const pillClass = variant === 'green' ? 'bg-brand-bg/10 text-brand-bg border-brand-bg/20' : 'bg-brand-secondary text-white border-brand-secondary/30';
---

<div data-component="GrowthAct" class={`${bgClass} rounded-2xl p-10 shadow-2xl hover:scale-[1.02] transition-all duration-500 flex flex-col h-full reveal border-2 border-white/5`}>
 <div class="mb-10 flex flex-col items-start">
 <span class={`inline-block px-4 py-1.5 rounded-xl text-[10px] font-brand-heading font-bold tracking-[0.2em] uppercase border mb-8 ${pillClass}`} set:html={formatText(act)}></span>
 <h3 class={`font-brand-heading text-3xl md:text-4xl mb-6 leading-tight uppercase tracking-tight ${headingColorClass}`} style="font-weight: 800;" set:html={formatText(title)}></h3>
 <p class={`font-brand-body text-lg leading-relaxed opacity-90 ${textColorClass}`} set:html={formatText(description)}></p>
 </div>
 
 <ul class="space-y-5 mb-12 flex-grow">
 {features.map((feature) => (
 <li class="flex items-start group">
 <div class={`w-2 h-2 rounded-full mr-4 mt-2.5 shrink-0 ${variant === 'green' ? 'bg-brand-bg' : 'bg-brand-secondary'} group-hover:scale-150 transition-transform shadow-lg`}></div>
 <span class={`font-brand-body text-base ${textColorClass} opacity-80 group-hover:opacity-100 transition-all`} set:html={formatText(feature)}></span>
 </li>
 ))}
 </ul>

 <div class="mt-auto pt-8 border-t border-white/10 flex flex-col gap-6">
  {(price || setup) && (
    <div class="flex flex-col gap-1">
      {price && (
        <div class={`font-brand-heading text-4xl font-bold tracking-tight ${headingColorClass}`}>
          {price}
          <span class={`font-brand-body text-sm font-normal ${textColorClass} opacity-60 ml-1`}>/mo</span>
        </div>
      )}
      {setup && <div class={`font-brand-body text-xs ${textColorClass} opacity-60 uppercase tracking-widest font-bold`}>{setup} setup</div>}
    </div>
  )}

  <a 
    href={ctaLink || "#"} 
    class={`font-brand-heading text-xs font-bold uppercase tracking-[0.2em] pb-1 border-b-2 transition-all self-start ${
    variant === 'green' 
    ? 'text-brand-bg border-brand-bg/30 hover:border-brand-bg' 
    : 'text-brand-secondary border-brand-secondary/30 hover:border-brand-secondary'
    }`}
  >
    {ctaText}
  </a>
 </div>
</div>
