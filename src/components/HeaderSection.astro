---
import { formatText } from '../utils/textFormatter';

interface Props {
 /** Small uppercase text above the main heading */
 eyebrow?: string;
 /** The main title of the section */
 heading: string;
 /** Optional supporting paragraph text */
 text?: string;
 /** Horizontal alignment of all content */
 alignment?: 'left' | 'center' | 'right';
 /** Background color style: default (dark), subtle (slight grey), accent (brand primary) */
 backgroundVariant?: 'default' | 'subtle' | 'accent';
 /** Controls the max-width of the content container */
 maxWidth?: 'narrow' | 'medium' | 'wide';
}

const { 
 eyebrow, 
 heading, 
 text,
 alignment = 'left',
 backgroundVariant = 'default',
 maxWidth = 'wide'
} = Astro.props;

const alignmentClasses = {
 left: 'text-left items-start',
 center: 'text-center items-center mx-auto',
 right: 'text-right items-end ml-auto'
};

const bgClass = {
 default: 'section-standard bg-brand-bg',
 subtle: 'section-subtle bg-brand-bg',
 accent: 'section-accent bg-brand-primary'
}[backgroundVariant];

const containerClass = {
 narrow: 'container-narrow',
 medium: 'container-medium',
 wide: 'container-wide'
}[maxWidth];
---

<section data-component="HeaderSection" class={bgClass}>
 <div class={`${containerClass} flex flex-col ${alignmentClasses[alignment]} reveal container mx-auto px-6`}>
 {eyebrow && (
 <span class="font-brand-heading text-white text-xl mb-4 tracking-wider uppercase" set:html={formatText(eyebrow)}></span>
 )}
 <h2 class={`font-brand-heading text-4xl md:text-6xl text-white max-w-4xl leading-tight ${alignment === 'center' ? 'mx-auto' : ''}`} set:html={formatText(heading)}></h2>
 {text && (
 <p class={`font-brand-body text-xl text-white mt-8 max-w-3xl leading-relaxed ${alignment === 'center' ? 'mx-auto' : ''}`} set:html={formatText(text)}>
 </p>
 )}
 </div>
</section>
