---
import { formatText } from '../utils/textFormatter';

interface Props {
 text: string;
}

const { text } = Astro.props;
---

<section data-component="CenteredText" class="section-accent">
 <div class="container-narrow text-center reveal">
 <p class="font-brand-body body-italic text-2xl md:text-3xl text-white" set:html={formatText(text)}></p>
 </div>
</section>
