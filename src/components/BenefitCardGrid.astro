---
import { formatText } from '../utils/textFormatter';

interface Card {
 eyebrow?: string;
 title: string;
 description: string;
 benefit: string;
}

interface Props {
 eyebrow?: string;
 heading: string;
 cards: Card[];
 backgroundVariant?: 'default' | 'subtle';
}

const { 
 eyebrow, 
 heading, 
 cards, 
 backgroundVariant = 'default' 
} = Astro.props;

const sectionClass = backgroundVariant === 'subtle' ? 'section-standard' : 'section-standard'; // Consolidated to standard for high-contrast
---

<section data-component="BenefitCardGrid" class={`${sectionClass} reveal`}>
 <div class="container-wide">
 <div class="mb-20 text-center container-narrow">
 {eyebrow && (
 <span class="font-brand-heading eyebrow" set:html={formatText(eyebrow)}></span>
 )}
 <h2 class="font-brand-heading heading-lg mb-8" set:html={formatText(heading)}></h2>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
 {cards.map((card) => (
 <div class="bg-brand-bg p-12 rounded-2xl flex flex-col h-full group transition-all duration-300">
 {card.eyebrow && (
 <span class="font-brand-heading eyebrow !text-[11px] !mb-6 !tracking-[0.3em]" set:html={formatText(card.eyebrow)}></span>
 )}
 <h3 class="font-brand-heading heading-md mb-8 text-white" set:html={formatText(card.title)}></h3>
 <p class="font-brand-body body-md mb-12 flex-grow text-white/80" set:html={formatText(card.description)}></p>
 
 <div class="p-10 bg-brand-secondary rounded-2xl transition-all group-hover:scale-[1.03] shadow-2xl">
 <span class="font-brand-heading text-brand-bg text-[10px] font-bold uppercase tracking-[0.2em] mb-3 block opacity-70">The Benefit:</span>
 <p class="font-brand-body text-brand-bg text-xl font-bold leading-tight" set:html={formatText(card.benefit)}></p>
 </div>
 </div>
 ))}
 </div>
 </div>
</section>
