---
import { formatText } from '../lib/textFormatter';

interface Item {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subheading?: string;
  problemsTitle: string;
  problems: Item[];
  solutionsTitle: string;
  solutions: Item[];
  backgroundVariant?: 'default' | 'subtle';
}

const { 
  heading, 
  subheading, 
  problemsTitle, 
  problems, 
  solutionsTitle, 
  solutions,
  backgroundVariant = 'default'
} = Astro.props;

const bgClass = backgroundVariant === 'subtle' ? 'bg-brand-bg/50' : 'bg-brand-bg';
---

<section data-component="ProblemSolutionGrid" class={`section-standard py-24 ${bgClass}`}>
  <div class="container mx-auto px-6 reveal">
    <div class="mb-20 text-center max-w-4xl mx-auto">
      <h2 class="font-brand-heading text-4xl md:text-6xl text-white mb-8 leading-tight" set:html={formatText(heading)}></h2>
      {subheading && (
        <p class="font-brand-body text-xl text-white/70 max-w-3xl mx-auto leading-relaxed" set:html={formatText(subheading)}></p>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
      <!-- Problems Column -->
      <div class="space-y-12">
        <h3 class="font-brand-heading text-2xl text-white flex items-center uppercase tracking-widest">
          <span class="w-12 h-1 bg-red-500 mr-6 rounded-full"></span>
          {problemsTitle}
        </h3>
        
        <div class="space-y-10">
          {problems.map((problem) => (
            <div class="flex group bg-white/5 p-8 rounded-xl border-2 border-white/10 hover:border-red-500/30 transition-all duration-300">
              <div class="mr-6 flex-shrink-0 mt-1">
                <div class="w-10 h-10 rounded-xl bg-red-500/20 border border-red-500/30 flex items-center justify-center text-red-500 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="font-brand-heading text-xl text-white mb-2 group-hover:text-red-400 transition-colors" set:html={formatText(problem.title)}></h4>
                <p class="font-brand-body text-white/70 leading-relaxed" set:html={formatText(problem.description)}></p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Solutions Column -->
      <div class="space-y-12 relative">
        <div class="hidden lg:block absolute -left-12 top-0 bottom-0 w-0.5 bg-white/10"></div>
        
        <h3 class="font-brand-heading text-2xl text-white flex items-center uppercase tracking-widest">
          <span class="w-12 h-1 bg-brand-secondary mr-6 rounded-full"></span>
          {solutionsTitle}
        </h3>

        <div class="space-y-10">
          {solutions.map((solution) => (
            <div class="flex group bg-white/5 p-8 rounded-xl border-2 border-white/10 hover:border-brand-secondary/30 transition-all duration-300">
              <div class="mr-6 flex-shrink-0 mt-1">
                <div class="w-10 h-10 rounded-xl bg-brand-secondary/20 border border-brand-secondary/30 flex items-center justify-center text-brand-secondary group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </div>
              </div>
              <div>
                <h4 class="font-brand-heading text-xl text-white mb-2 group-hover:text-brand-secondary transition-colors" set:html={formatText(solution.title)}></h4>
                <p class="font-brand-body text-white/70 leading-relaxed" set:html={formatText(solution.description)}></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
