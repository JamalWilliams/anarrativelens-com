---
import { getSiteConfig } from '../lib/config';
import Layout from '../layouts/Layout.astro';
import SectionRenderer from '../components/SectionRenderer.astro';

const config = await getSiteConfig();

const pageData = {
  title: "Shop",
  hero: {
    heading: "The **Sovereign** Store.",
    subheading: "Strategic Assets, Toolkits, and Guides for the Modern Architect.",
    backgroundImage: config.brand.heroBackgrounds?.shop || ""
  },
  sections: [
    {
      type: "product-grid",
      products: [
        {
          title: "The Growth Story System",
          price: "$297",
          description: "The complete 3-Act framework for scaling your digital brand.",
          category: "System",
          link: "/the-growth-story-system"
        },
        {
          title: "The Content Engine",
          price: "$97",
          description: "A plug-and-play Obsidian toolkit for managing your digital narrative.",
          category: "Toolkit",
          link: "/contact"
        }
      ]
    }
  ]
};
---

<Layout title={pageData.title}>
  <SectionRenderer sections={pageData.sections} hero={pageData.hero} />
</Layout>
